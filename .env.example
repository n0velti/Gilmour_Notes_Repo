# Copy to ".env" and fill values. Never commit ".env".

# Instant sign-up (no email link): Supabase Dashboard → Authentication → Providers → Email
# → turn OFF "Confirm email" (or users must verify by mail before sign-in).

# Supabase → Project Settings → API (safe to bundle in the app; protected by RLS)
EXPO_PUBLIC_SUPABASE_URL=https://jwyrfcdaltrdiqrdwrov.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Reference only (not required in the client)
# SUPABASE_PROJECT_ID=jwyrfcdaltrdiqrdwrov

# Server-side / Edge Functions / CI ONLY — bypasses RLS. Do NOT use in Expo/React Native.
# Do NOT prefix with EXPO_PUBLIC_. Never import this file or key in app code.
# SUPABASE_SERVICE_ROLE_KEY=
